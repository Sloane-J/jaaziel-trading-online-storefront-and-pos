{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "files": {
    "includes": [
      "app/**/*.php",
      "config/**/*.php",
      "database/**/*.php",
      "resources/**/*.blade.php",
      "resources/**/*.js",
      "resources/**/*.css",
      "routes/**/*.php",
      "tests/**/*.php",
      "!**/*.generated.*"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!tests/**"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}